+
+// A spawned program has already finished: wait collects what it left.
+static struct {
+  pid_t pid;
+  int status;
+} children[64];
+static pid_t next_child = 1;
+
+int posix_spawnp(pid_t *restrict pid, const char *restrict file, const posix_spawn_file_actions_t *actions,
+                 const posix_spawnattr_t *restrict attributes, char *const argv[restrict], char *const environment[restrict]) {
+  (void)attributes;
+  (void)environment;
+  if (actions && actions->__actions)
+    return ENOTSUP;
+  char *arguments = quoted(argv);
+  if (!arguments)
+    return ENOMEM;
+  int status = run(arguments, "", "", file);
+  free(arguments);
+  for (size_t i = 0; i < sizeof children / sizeof *children; i++) {
+    if (!children[i].pid) {
+      children[i].pid = next_child++ + getpid();
+      children[i].status = status;
+      if (pid)
+        *pid = children[i].pid;
+      return 0;
+    }
+  }
+  return EAGAIN;
+}
+
+int posix_spawn(pid_t *restrict pid, const char *restrict path, const posix_spawn_file_actions_t *actions,
+                const posix_spawnattr_t *restrict attributes, char *const argv[restrict], char *const environment[restrict]) {
+  return posix_spawnp(pid, path, actions, attributes, argv, environment);
+}
+
+int posix_spawn_file_actions_init(posix_spawn_file_actions_t *actions) {
+  memset(actions, 0, sizeof *actions);
+  return 0;
+}
+int posix_spawn_file_actions_destroy(posix_spawn_file_actions_t *actions) {
+  (void)actions;
+  return 0;
+}
+int posix_spawnattr_init(posix_spawnattr_t *attributes) {
+  memset(attributes, 0, sizeof *attributes);
+  return 0;
+}
+int posix_spawnattr_destroy(posix_spawnattr_t *attributes) {
+  (void)attributes;
+  return 0;
+}
+
+pid_t waitpid(pid_t pid, int *status, int options) {
+  (void)options;
+  for (size_t i = 0; i < sizeof children / sizeof *children; i++) {
+    if (children[i].pid && (pid <= 0 || children[i].pid == pid)) {
+      pid_t found = children[i].pid;
+      if (status)
+        *status = children[i].status;
+      children[i].pid = 0;
+      return found;
+    }
+  }
+  errno = ECHILD;
+  return -1;
+}
+
+pid_t wait(int *status) { return waitpid(-1, status, 0); }
