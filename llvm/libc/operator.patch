+// MARK: - Sockets
+
+/// The text form of an address, or -1 (errno set).
+static int address_text(const struct sockaddr *address, socklen_t size, char text[INET6_ADDRSTRLEN], int *port) {
+  if (address->sa_family == AF_INET && size >= sizeof(struct sockaddr_in)) {
+    const struct sockaddr_in *ipv4 = (const void *)address;
+    inet_ntop(AF_INET, &ipv4->sin_addr, text, INET6_ADDRSTRLEN);
+    *port = ntohs(ipv4->sin_port);
+    return 0;
+  }
+  if (address->sa_family == AF_INET6 && size >= sizeof(struct sockaddr_in6)) {
+    const struct sockaddr_in6 *ipv6 = (const void *)address;
+    inet_ntop(AF_INET6, &ipv6->sin6_addr, text, INET6_ADDRSTRLEN);
+    *port = ntohs(ipv6->sin6_port);
+    return 0;
+  }
+  errno = EAFNOSUPPORT;
+  return -1;
+}
+
+static void store_address(const char *text, int port, struct sockaddr *address, socklen_t *size) {
+  if (!address || !size)
+    return;
+  struct sockaddr_storage storage;
+  memset(&storage, 0, sizeof storage);
+  socklen_t length;
+  if (strchr(text, ':')) {
+    struct sockaddr_in6 *ipv6 = (void *)&storage;
+    ipv6->sin6_family = AF_INET6;
+    ipv6->sin6_port = htons(port);
+    inet_pton(AF_INET6, text, &ipv6->sin6_addr);
+    length = sizeof *ipv6;
+  } else {
+    struct sockaddr_in *ipv4 = (void *)&storage;
+    ipv4->sin_family = AF_INET;
+    ipv4->sin_port = htons(port);
+    inet_pton(AF_INET, text, &ipv4->sin_addr);
+    length = sizeof *ipv4;
+  }
+  memcpy(address, &storage, length < *size ? length : *size);
+  *size = length;
+}
+
+// The descriptors that are sockets. They go straight to the kernel: read and write here, not through file streams.
+#define MAX_SOCKETS 1024
+static unsigned char sockets[MAX_SOCKETS];
+
+void __operator_note_socket(int fd, int is_socket) {
+  if (fd >= 0 && fd < MAX_SOCKETS)
+    sockets[fd] = is_socket;
+}
+
+static int is_socket(int fd) { return fd >= 0 && fd < MAX_SOCKETS && sockets[fd]; }
+
+void __operator_set_nonblocking(int file, int on) { kernel_socket_option(file, 8, on, 1); }
+
+/// recv and send for read and write: the bytes, or -2 if `fd` isn't a socket.
+ssize_t __operator_socket_read(int fd, void *data, size_t size) {
+  if (!is_socket(fd))
+    return -2;
+  return recv(fd, data, size, 0);
+}
+
+ssize_t __operator_socket_write(int fd, const void *data, size_t size) {
+  if (!is_socket(fd))
+    return -2;
+  return send(fd, data, size, 0);
+}
+
+/// poll, if a socket is among the descriptors; -2 if none is. Anything else counts as ready.
+int __operator_poll(struct pollfd *fds, nfds_t count, const struct timespec *timeout) {
+  int found = 0;
+  for (nfds_t i = 0; i < count; i++)
+    found |= is_socket(fds[i].fd);
+  if (!found)
+    return -2;
+  int32_t *entries = malloc(count * 8 + 8);
+  if (!entries) {
+    errno = ENOMEM;
+    return -1;
+  }
+  size_t used = 0;
+  int ready = 0;
+  for (nfds_t i = 0; i < count; i++) {
+    fds[i].revents = 0;
+    if (fds[i].fd < 0)
+      continue;
+    if (is_socket(fds[i].fd)) {
+      entries[used * 2] = file_of(fds[i].fd);
+      entries[used * 2 + 1] = ((fds[i].events & POLLIN) ? 1 : 0) | ((fds[i].events & POLLOUT) ? 2 : 0);
+      used++;
+    } else if (fds[i].events & (POLLIN | POLLOUT)) {
+      fds[i].revents = fds[i].events & (POLLIN | POLLOUT);
+      ready++;
+    }
+  }
+  int wait = ready ? 0 : !timeout ? -1 : timeout->tv_sec * 1000 + timeout->tv_nsec / 1000000;
+  struct string reply = {0, 0};
+  kernel_poll(entries, used * 8, wait, &reply);
+  free(entries);
+  const uint16_t *events = (const void *)reply.pointer;
+  size_t next = 0;
+  for (nfds_t i = 0; i < count; i++) {
+    if (!is_socket(fds[i].fd))
+      continue;
+    int happened = next * 2 < reply.length ? events[next] : 0;
+    next++;
+    fds[i].revents = ((happened & 1) ? POLLIN : 0) | ((happened & 2) ? POLLOUT : 0) | ((happened & 0x1000) ? POLLERR : 0) |
+                     ((happened & 0x2000) ? POLLHUP : 0);
+    fds[i].revents &= fds[i].events | POLLERR | POLLHUP;
+    if (fds[i].revents)
+      ready++;
+  }
+  free(reply.pointer);
+  return ready;
+}
+
+int socket(int domain, int type, int protocol) {
+  int kind = type & ~(SOCK_NONBLOCK | SOCK_CLOEXEC);
+  if (domain != AF_INET && domain != AF_INET6) {
+    errno = EAFNOSUPPORT;
+    return -1;
+  }
+  if (kind != SOCK_STREAM && kind != SOCK_DGRAM) {
+    errno = EPROTONOSUPPORT;
+    return -1;
+  }
+  int32_t handle = kernel_socket(domain == AF_INET ? 4 : 6, kind == SOCK_STREAM ? 1 : 2, protocol);
+  if (handle < 0) {
+    errno = -handle;
+    return -1;
+  }
+  int fd = __wasilibc_add_file((filesystem_own_descriptor_t){handle}, O_RDWR);
+  __operator_note_socket(fd, 1);
+  if (fd >= 0 && (type & SOCK_NONBLOCK))
+    __operator_set_nonblocking(handle, 1);
+  return fd;
+}
+
+int __operator_connect(int file, const struct sockaddr *address, socklen_t size) {
+  char text[INET6_ADDRSTRLEN];
+  int port;
+  if (address_text(address, size, text, &port) < 0)
+    return -1;
+  return check(kernel_connect(file, text, strlen(text), port));
+}
+
+int __operator_bind(int file, const struct sockaddr *address, socklen_t size) {
+  char text[INET6_ADDRSTRLEN];
+  int port;
+  if (address_text(address, size, text, &port) < 0)
+    return -1;
+  return check(kernel_bind(file, text, strlen(text), port));
+}
+
+int __operator_listen(int file, int backlog) { return check(kernel_listen(file, backlog)); }
+
+int __operator_accept(int file, struct sockaddr *address, socklen_t *size) {
+  int32_t handle = kernel_accept(file);
+  if (handle < 0) {
+    errno = -handle;
+    return -1;
+  }
+  __operator_socket_name(handle, 1, address, size);
+  int fd = __wasilibc_add_file((filesystem_own_descriptor_t){handle}, O_RDWR);
+  __operator_note_socket(fd, 1);
+  return fd;
+}
+
+int __operator_socket_name(int file, int peer, struct sockaddr *address, socklen_t *size) {
+  struct string text = {0, 0};
+  kernel_socket_name(file, peer, &text);
+  if (!text.length) {
+    free(text.pointer);
+    errno = peer ? ENOTCONN : EINVAL;
+    return -1;
+  }
+  char copy[80] = {0}, ip[64] = {0};
+  memcpy(copy, text.pointer, text.length < 79 ? text.length : 79);
+  free(text.pointer);
+  int port = 0;
+  sscanf(copy, "%63s %d", ip, &port);
+  store_address(ip, port, address, size);
+  return 0;
+}
+
+int __operator_shutdown(int file, int how) { return check(kernel_shutdown(file, how)); }
+
+ssize_t __operator_send_to(int file, const void *data, size_t size, const struct sockaddr *address, socklen_t address_size) {
+  char text[INET6_ADDRSTRLEN] = "";
+  int port = 0;
+  if (address && address_text(address, address_size, text, &port) < 0)
+    return -1;
+  int32_t sent = kernel_send_to(file, data, size, text, strlen(text), port);
+  if (sent < 0) {
+    errno = -sent;
+    return -1;
+  }
+  return sent;
+}
+
+ssize_t __operator_receive_from(int file, void *data, size_t size, int flags, struct sockaddr *address, socklen_t *address_size) {
+  struct string reply = {0, 0};
+  kernel_receive_from(file, size, (flags & MSG_PEEK) != 0, &reply);
+  const unsigned char *bytes = (const void *)reply.pointer;
+  int32_t error;
+  memcpy(&error, bytes, 4);
+  if (error) {
+    free(reply.pointer);
+    errno = error;
+    return -1;
+  }
+  int port = bytes[4] | bytes[5] << 8;
+  size_t length = bytes[6];
+  char text[64] = {0};
+  memcpy(text, bytes + 7, length < 63 ? length : 63);
+  size_t received = reply.length - 7 - length;
+  memcpy(data, bytes + 7 + length, received);
+  free(reply.pointer);
+  if (text[0])
+    store_address(text, port, address, address_size);
+  return received;
+}
+
+/// The kernel's number for a socket option (1 SO_REUSEADDR, 2 SO_KEEPALIVE, 3 SO_ERROR, 4 SO_BROADCAST, 5 TCP_NODELAY,
+/// 6 SO_RCVBUF, 7 SO_SNDBUF), or 0.
+static int option_number(int level, int name) {
+  if (level == SOL_SOCKET) {
+    switch (name) {
+    case SO_REUSEADDR: return 1;
+    case SO_KEEPALIVE: return 2;
+    case SO_ERROR: return 3;
+#ifdef SO_BROADCAST
+    case SO_BROADCAST: return 4;
+#endif
+#ifdef SO_RCVBUF
+    case SO_RCVBUF: return 6;
+#endif
+#ifdef SO_SNDBUF
+    case SO_SNDBUF: return 7;
+#endif
+    }
+  } else if (level == IPPROTO_TCP && name == 1 /* TCP_NODELAY */) {
+    return 5;
+  }
+  return 0;
+}
+
+int __operator_get_option(int file, int level, int name, void *value, socklen_t *size) {
+  int option = option_number(level, name);
+  if (!option) {
+    errno = ENOPROTOOPT;
+    return -1;
+  }
+  int32_t result = kernel_socket_option(file, option, 0, 0);
+  if (result < 0) {
+    errno = -result;
+    return -1;
+  }
+  memcpy(value, &result, *size < 4 ? *size : 4);
+  *size = 4;
+  return 0;
+}
+
+int __operator_set_option(int file, int level, int name, const void *value, socklen_t size) {
+  int option = option_number(level, name);
+  if (!option) {
+    errno = ENOPROTOOPT;
+    return -1;
+  }
+  int32_t number = 0;
+  memcpy(&number, value, size < 4 ? size : 4);
+  int32_t result = kernel_socket_option(file, option, number, 1);
+  if (result < 0) {
+    errno = -result;
+    return -1;
+  }
+  return 0;
+}
+
+// MARK: - Names
+
+static struct addrinfo *one_result(const char *text, int port, int socket_type, int protocol) {
+  struct addrinfo *result = calloc(1, sizeof *result);
+  struct sockaddr_storage *address = calloc(1, sizeof *address);
+  if (!result || !address) {
+    free(result);
+    free(address);
+    return NULL;
+  }
+  socklen_t size = sizeof *address;
+  store_address(text, port, (void *)address, &size);
+  result->ai_family = address->ss_family;
+  result->ai_socktype = socket_type;
+  result->ai_protocol = protocol;
+  result->ai_addr = (void *)address;
+  result->ai_addrlen = size;
+  return result;
+}
+
+int getaddrinfo(const char *restrict host, const char *restrict service, const struct addrinfo *restrict hints,
+                struct addrinfo **restrict results) {
+  int family = hints ? hints->ai_family : AF_UNSPEC, flags = hints ? hints->ai_flags : 0;
+  int socket_type = hints ? hints->ai_socktype : 0, protocol = hints ? hints->ai_protocol : 0;
+  if (!host && !service)
+    return EAI_NONAME;
+  int port = 0;
+  if (service) {
+    char *end;
+    port = strtol(service, &end, 10);
+    if (*end) {
+      struct servent *entry = (flags & AI_NUMERICSERV) ? NULL : getservbyname(service, NULL);
+      if (!entry)
+        return EAI_SERVICE;
+      port = ntohs(entry->s_port);
+    }
+  }
+  char *addresses;
+  unsigned char ignored[16];
+  if (!host) {
+    addresses = strdup(flags & AI_PASSIVE ? "0.0.0.0 ::" : "127.0.0.1 ::1");
+  } else if (inet_pton(AF_INET, host, ignored) == 1 || inet_pton(AF_INET6, host, ignored) == 1) {
+    addresses = strdup(host);
+  } else if (flags & AI_NUMERICHOST) {
+    return EAI_NONAME;
+  } else {
+    struct string text = {0, 0};
+    kernel_resolve(host, strlen(host), &text);
+    if (!text.length) {
+      free(text.pointer);
+      return EAI_NONAME;
+    }
+    addresses = strndup(text.pointer, text.length);
+    free(text.pointer);
+  }
+  if (!addresses)
+    return EAI_MEMORY;
+  struct addrinfo *first = NULL, **next = &first;
+  static const int kinds[] = {SOCK_STREAM, SOCK_DGRAM};
+  for (char *item = strtok(addresses, " "); item; item = strtok(NULL, " ")) {
+    int found = strchr(item, ':') ? AF_INET6 : AF_INET;
+    if (family != AF_UNSPEC && family != found)
+      continue;
+    for (int i = 0; i < 2; i++) {
+      if (socket_type && socket_type != kinds[i])
+        continue;
+      struct addrinfo *entry = one_result(item, port, kinds[i], protocol ? protocol : kinds[i] == SOCK_STREAM ? IPPROTO_TCP : IPPROTO_UDP);
+      if (!entry) {
+        free(addresses);
+        freeaddrinfo(first);
+        return EAI_MEMORY;
+      }
+      *next = entry;
+      next = &entry->ai_next;
+    }
+  }
+  free(addresses);
+  if (!first)
+    return EAI_NONAME;
+  if (host && (flags & AI_CANONNAME))
+    first->ai_canonname = strdup(host);
+  *results = first;
+  return 0;
+}
+
+struct hostent *gethostbyname(const char *name) {
+  static struct hostent entry;
+  static char *aliases[1], *list[2], address[16];
+  struct addrinfo hints = {.ai_family = AF_INET, .ai_socktype = SOCK_STREAM}, *result;
+  if (getaddrinfo(name, NULL, &hints, &result)) {
+    h_errno = HOST_NOT_FOUND;
+    return NULL;
+  }
+  memcpy(address, &((struct sockaddr_in *)result->ai_addr)->sin_addr, 4);
+  freeaddrinfo(result);
+  list[0] = address;
+  entry = (struct hostent){(char *)name, aliases, AF_INET, 4, list};
+  return &entry;
+}
+
+int getnameinfo(const struct sockaddr *restrict address, socklen_t size, char *restrict host, socklen_t host_size,
+                char *restrict service, socklen_t service_size, int flags) {
+  (void)flags;
+  char text[INET6_ADDRSTRLEN];
+  int port;
+  if (address_text(address, size, text, &port) < 0)
+    return EAI_FAMILY;
+  if (host && host_size)
+    snprintf(host, host_size, "%s", text);
+  if (service && service_size)
+    snprintf(service, service_size, "%d", port);
+  return 0;
+}
