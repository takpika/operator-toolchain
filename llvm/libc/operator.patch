+static int fill_template(char *template, size_t suffix, int (*attempt)(const char *, int), int flags) {
+  size_t length = strlen(template);
+  if (length < 6 + suffix || memcmp(template + length - suffix - 6, "XXXXXX", 6)) {
+    errno = EINVAL;
+    return -1;
+  }
+  static const char letters[] = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
+  char *name = template + length - suffix - 6;
+  for (int tries = 0; tries < 100; tries++) {
+    unsigned char random[6];
+    getentropy(random, sizeof random);
+    for (int i = 0; i < 6; i++)
+      name[i] = letters[random[i] % (sizeof letters - 1)];
+    int result = attempt(template, flags);
+    if (result >= 0 || errno != EEXIST)
+      return result;
+  }
+  memcpy(name, "XXXXXX", 6);
+  errno = EEXIST;
+  return -1;
+}
