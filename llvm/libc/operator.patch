+  (void)flags;
+  if (fd != AT_FDCWD && path[0] != '/') {
+    errno = ENOTSUP;
+    return -1;
+  }
+  return __operator_chmod(path, mode);
+}
+
+int chown(const char *path, uid_t uid, gid_t gid) { return check(kernel_chown(path, strlen(path), uid, gid, 1)); }
+int lchown(const char *path, uid_t uid, gid_t gid) { return check(kernel_chown(path, strlen(path), uid, gid, 0)); }
+int fchown(int fd, uid_t uid, gid_t gid) {
+  if (file_of(fd) < 0)
+    return -1;
+  if (uid != (uid_t)-1 && uid != getuid()) {
+    errno = EPERM;
+    return -1;
+  }
+  if (gid != (gid_t)-1 && gid != getgid()) {
+    errno = EPERM;
+    return -1;
+  }
+  return 0;
+}
+
+int mkfifo(const char *path, mode_t mode) { return check(kernel_mkfifo(path, strlen(path), (mode & 07777) & ~process_umask)); }
+
+int fchdir(int fd) {
+  int file = file_of(fd);
+  return file < 0 ? -1 : check(kernel_fchdir(file));
+}
+
+int flock(int fd, int operation) {
+  int file = file_of(fd);
+  return file < 0 ? -1 : check(kernel_flock(file, operation));
+}
+
+int lockf(int fd, int operation, off_t size) {
+  struct flock lock = {.l_type = F_WRLCK, .l_whence = SEEK_CUR, .l_len = size};
+  switch (operation) {
+  case F_ULOCK:
+    lock.l_type = F_UNLCK;
+    return __operator_record_lock(fd, F_SETLK, &lock);
+  case F_LOCK:
+    return __operator_record_lock(fd, F_SETLKW, &lock);
+  case F_TLOCK:
+    return __operator_record_lock(fd, F_SETLK, &lock);
+  case F_TEST:
+    if (__operator_record_lock(fd, F_GETLK, &lock) < 0)
+      return -1;
+    if (lock.l_type == F_UNLCK)
+      return 0;
+    errno = EAGAIN;
+    return -1;
+  }
+  errno = EINVAL;
+  return -1;
+}
+
+int __operator_record_lock(int fd, int command, struct flock *lock) {
+  int file = file_of(fd);
+  if (file < 0)
+    return -1;
+  off_t start = lock->l_start;
+  if (lock->l_whence == SEEK_CUR) {
+    off_t position = lseek(fd, 0, SEEK_CUR);
+    if (position >= 0)
+      start += position;
+  } else if (lock->l_whence == SEEK_END) {
+    struct stat info;
+    if (fstat(fd, &info) == 0)
+      start += info.st_size;
+  }
+  int kind = lock->l_type == F_RDLCK ? 0 : lock->l_type == F_WRLCK ? 1 : 2;
+  int32_t result = kernel_lock(file, command == F_GETLK ? 0 : command == F_SETLK ? 1 : 2, kind, start, lock->l_len);
+  if (result < 0) {
+    errno = -result;
+    return -1;
+  }
+  if (command == F_GETLK)
+    lock->l_type = result == 0 ? F_UNLCK : result == 1 ? F_RDLCK : F_WRLCK;
+  return 0;
+}
+
+static int statfs_of(const char *path, struct statvfs *buffer) {
+  struct string text = {0, 0};
+  kernel_statfs(path, strlen(path), &text);
+  if (!text.length) {
+    free(text.pointer);
+    errno = ENOENT;
+    return -1;
+  }
+  char copy[96] = {0};
+  memcpy(copy, text.pointer, text.length < 95 ? text.length : 95);
+  free(text.pointer);
+  unsigned long long size = 0, blocks = 0, available = 0;
+  sscanf(copy, "%llu %llu %llu", &size, &blocks, &available);
+  memset(buffer, 0, sizeof *buffer);
+  buffer->f_bsize = buffer->f_frsize = size;
+  buffer->f_blocks = blocks;
+  buffer->f_bfree = buffer->f_bavail = available;
+  buffer->f_namemax = 255;
+  return 0;
+}
+
+int statvfs(const char *restrict path, struct statvfs *restrict buffer) { return statfs_of(path, buffer); }
+int fstatvfs(int fd, struct statvfs *buffer) {
+  struct stat info;
+  if (fstat(fd, &info) < 0)
+    return -1;
+  return statfs_of("/", buffer);
+}
