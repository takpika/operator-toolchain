+/// The kernel's handle for `fd`, or -1 (errno set).
+static int file_of(int fd) {
+  descriptor_table_entry_t entry;
+  filesystem_borrow_descriptor_t file;
+  if (descriptor_table_get(fd, &entry) < 0)
+    return -1;
+  if (!entry.vtable->get_file || entry.vtable->get_file(entry.data, &file) < 0) {
+    errno = EBADF;
+    return -1;
+  }
+  return file.__handle;
+}
