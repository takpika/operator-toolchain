+
+// popen runs the command to its end: for reading when it's opened, into a file, and for writing when it's closed, from one.
+#define MAX_PIPES 16
+static struct {
+  FILE *file;
+  char path[32];
+  char *command;
+  int status;
+} pipes[MAX_PIPES];
+
+FILE *popen(const char *command, const char *mode) {
+  int slot = 0;
+  while (slot < MAX_PIPES && pipes[slot].file)
+    slot++;
+  if (slot == MAX_PIPES || (mode[0] != 'r' && mode[0] != 'w')) {
+    errno = slot == MAX_PIPES ? EMFILE : EINVAL;
+    return NULL;
+  }
+  strcpy(pipes[slot].path, "/tmp/popen_XXXXXX");
+  int fd = mkstemp(pipes[slot].path);
+  if (fd < 0)
+    return NULL;
+  if (mode[0] == 'r') {
+    close(fd);
+    pipes[slot].status = run(command, "", pipes[slot].path, "");
+    pipes[slot].file = fopen(pipes[slot].path, "r");
+    unlink(pipes[slot].path);
+  } else {
+    pipes[slot].command = strdup(command);
+    pipes[slot].file = fdopen(fd, "w");
+  }
+  return pipes[slot].file;
+}
+
+int pclose(FILE *file) {
+  for (int slot = 0; slot < MAX_PIPES; slot++) {
+    if (pipes[slot].file != file)
+      continue;
+    fclose(file);
+    pipes[slot].file = NULL;
+    if (pipes[slot].command) {
+      pipes[slot].status = run(pipes[slot].command, pipes[slot].path, "", "");
+      free(pipes[slot].command);
+      pipes[slot].command = NULL;
+      unlink(pipes[slot].path);
+    }
+    return pipes[slot].status;
+  }
+  errno = ECHILD;
+  return -1;
+}
+
+/// The arguments after argv[0], quoted for the shell.
+static char *quoted(char *const argv[]) {
+  size_t size = 1;
+  for (int i = 1; argv[i]; i++)
+    size += 4 * strlen(argv[i]) + 3;
+  char *text = malloc(size), *end = text;
+  if (!text)
+    return NULL;
+  for (int i = 1; argv[i]; i++) {
+    *end++ = '\'';
+    for (const char *c = argv[i]; *c; c++) {
+      if (*c == '\'') {
+        memcpy(end, "'\\''", 4);
+        end += 4;
+      } else {
+        *end++ = *c;
+      }
+    }
+    *end++ = '\'';
+    *end++ = ' ';
+  }
+  *end = 0;
+  return text;
+}
+
+/// Replacing the program: the kernel runs the new one, and this one ends with its status.
+int execvp(const char *file, char *const argv[]) {
+  char *arguments = quoted(argv);
+  if (!arguments) {
+    errno = ENOMEM;
+    return -1;
+  }
+  int status = run(arguments, "", "", file);
+  free(arguments);
+  _Exit(WIFEXITED(status) ? WEXITSTATUS(status) : 128 + WTERMSIG(status));
+}
+
+int execv(const char *path, char *const argv[]) { return execvp(path, argv); }
+int execve(const char *path, char *const argv[], char *const environment[]) {
+  (void)environment;
+  return execvp(path, argv);
+}
+
+static char **collect(const char *first, va_list arguments, char ***after) {
+  va_list counting;
+  va_copy(counting, arguments);
+  size_t count = 2;
+  while (va_arg(counting, char *))
+    count++;
+  va_end(counting);
+  char **list = calloc(count + 1, sizeof(char *));
+  if (!list)
+    return NULL;
+  list[0] = (char *)first;
+  size_t i = 1;
+  for (char *item; (item = va_arg(arguments, char *)); i++)
+    list[i] = item;
+  list[i] = NULL;
+  if (after)
+    *after = va_arg(arguments, char **);
+  return list;
+}
+
+int execl(const char *path, const char *first, ...) {
+  va_list arguments;
+  va_start(arguments, first);
+  char **list = collect(first, arguments, NULL);
+  va_end(arguments);
+  return list ? execv(path, list) : -1;
+}
+
+int execlp(const char *file, const char *first, ...) {
+  va_list arguments;
+  va_start(arguments, first);
+  char **list = collect(first, arguments, NULL);
+  va_end(arguments);
+  return list ? execvp(file, list) : -1;
+}
+
+int execle(const char *path, const char *first, ...) {
+  va_list arguments;
+  va_start(arguments, first);
+  char **list = collect(first, arguments, NULL);
+  va_end(arguments);
+  return list ? execv(path, list) : -1;
+}
