@@ -18,8 +18,33 @@ struct map {
   int flags;
   off_t offset;
   size_t length;
+  int fd;
 };
 
+// A shared mapping goes back to its file when asked and when it's unmapped.
+static int write_back(struct map *map) {
+  if (!(map->flags & MAP_SHARED) || !(map->prot & PROT_WRITE) || map->fd < 0)
+    return 0;
+  const char *body = (const char *)(map + 1);
+  size_t left = map->length;
+  off_t offset = map->offset;
+  while (left > 0) {
+    ssize_t written = pwrite(map->fd, body, left, offset);
+    if (written < 0)
+      return -1;
+    left -= (size_t)written;
+    offset += written;
+    body += written;
+  }
+  return 0;
+}
+
+int msync(void *addr, size_t length, int flags) {
+  (void)length;
+  (void)flags;
+  return write_back((struct map *)addr - 1);
+}
+
 void *mmap(void *addr, size_t length, int prot, int flags, int fd,
            off_t offset) {
   // Check for unsupported flags.
@@ -79,6 +104,7 @@ void *mmap(void *addr, size_t length, int prot, int flags, int fd,
   map->flags = flags;
   map->offset = offset;
   map->length = length;
+  map->fd = (flags & MAP_SHARED) && (prot & PROT_WRITE) && !(flags & MAP_ANON) ? dup(fd) : -1;
 
   // Initialize the main memory buffer, either with the contents of a file,
   // or with zeros.
@@ -119,7 +145,12 @@ int munmap(void *addr, size_t length) {
   }
 
   // Release the memory.
+  int written = write_back(map);
+  if (map->fd >= 0)
+    close(map->fd);
   free(map);
+  if (written < 0)
+    return -1;
 
   // Success!
   return 0;
diff --git a/libc-bottom-half/signal/signal.c b/libc-bottom-half/signal/signal.c
index ff946aa..23c6781 100644
--- a/libc-bottom-half/signal/signal.c
+++ b/libc-bottom-half/signal/signal.c
@@ -139,3 +139,62 @@ void (*signal(int sig, void (*func)(int)))(int) {
 
 extern __typeof(signal) bsd_signal __attribute__((weak, alias("signal")));
 extern __typeof(signal) __sysv_signal __attribute__((weak, alias("signal")));
+
+// The rest of the signal calls, over the above: a handler runs when the program raises the signal itself.
+#include <string.h>
+#include <unistd.h>
+
+static sigset_t blocked;
+
+int sigemptyset(sigset_t *set) { memset(set, 0, sizeof *set); return 0; }
+int sigfillset(sigset_t *set) { memset(set, 0xff, sizeof *set); return 0; }
+static int bit(int sig, size_t *word, unsigned long *mask) {
+  if (sig < 1 || sig > 64) { errno = EINVAL; return -1; }
+  *word = (size_t)(sig - 1) / (8 * sizeof(unsigned long));
+  *mask = 1UL << ((sig - 1) % (8 * sizeof(unsigned long)));
+  return 0;
+}
+int sigaddset(sigset_t *set, int sig) {
+  size_t word; unsigned long mask;
+  if (bit(sig, &word, &mask)) return -1;
+  set->__bits[word] |= mask;
+  return 0;
+}
+int sigdelset(sigset_t *set, int sig) {
+  size_t word; unsigned long mask;
+  if (bit(sig, &word, &mask)) return -1;
+  set->__bits[word] &= ~mask;
+  return 0;
+}
+int sigismember(const sigset_t *set, int sig) {
+  size_t word; unsigned long mask;
+  if (bit(sig, &word, &mask)) return -1;
+  return (set->__bits[word] & mask) != 0;
+}
+int sigprocmask(int how, const sigset_t *restrict set, sigset_t *restrict old) {
+  if (old) *old = blocked;
+  if (!set) return 0;
+  for (size_t i = 0; i < sizeof(blocked.__bits) / sizeof(*blocked.__bits); i++) {
+    if (how == SIG_BLOCK) blocked.__bits[i] |= set->__bits[i];
+    else if (how == SIG_UNBLOCK) blocked.__bits[i] &= ~set->__bits[i];
+    else if (how == SIG_SETMASK) blocked.__bits[i] = set->__bits[i];
+    else { errno = EINVAL; return -1; }
+  }
+  return 0;
+}
+int pthread_sigmask(int how, const sigset_t *restrict set, sigset_t *restrict old) {
+  return sigprocmask(how, set, old) ? errno : 0;
+}
+int sigpending(sigset_t *set) { return sigemptyset(set); }
+int sigaction(int sig, const struct sigaction *restrict action, struct sigaction *restrict old) {
+  void (*previous)(int) = SIG_DFL;
+  if (action) previous = signal(sig, action->sa_handler);
+  else { previous = signal(sig, SIG_DFL); signal(sig, previous); }
+  if (previous == SIG_ERR) return -1;
+  if (old) { memset(old, 0, sizeof *old); old->sa_handler = previous; }
+  return 0;
+}
+int kill(pid_t pid, int sig) {
+  if (pid != getpid() && pid != 0 && pid != -1) { errno = ESRCH; return -1; }
+  return sig ? raise(sig) : 0;
+}
